# =========================================================================
# APPLICATION ENVIRONMENT CONFIGURATION (.env.example)
# =========================================================================

# Database Connection (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=chronic_disease_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Connection Strings
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/chronic_disease_db
SYNC_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/chronic_disease_db

# Security & JWT Secrets (Min 32 characters for HS256)
SECRET_KEY=supersecretjwtkey_chronic_disease_2026_thesis_security_key_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Project Environment
PROJECT_NAME="Chronic Disease Risk Assessment System"
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# External LLM API (Google Gemini Free API)
GEMINI_API_KEY=your_gemini_api_key_here
