# =========================================================================
# FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Hãy sao chép tệp này thành .env và điền các giá trị thực tế của bạn.
# Tuyệt đối không commit tệp .env chứa mật khẩu thật lên Git repository!
# =========================================================================

# Cấu hình Cơ sở dữ liệu (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=chronic_disease_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Chuỗi kết nối SQLAlchemy (Tự động nạp hoặc ghi đè tùy chọn)
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5432/chronic_disease_db
SYNC_DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/chronic_disease_db

# Bảo mật & Khóa bí mật JWT (Tối thiểu 32 ký tự ngẫu nhiên cho thuật toán HS256)
SECRET_KEY=your_random_secret_key_at_least_32_characters_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Môi trường chạy ứng dụng
PROJECT_NAME="Chronic Disease Risk Assessment System"
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# Cấu hình CORS (Cho phép Frontend Next.js gọi API)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Khóa API tích hợp LLM bên ngoài (Google Gemini Free API)
GEMINI_API_KEY=your_gemini_api_key_here
